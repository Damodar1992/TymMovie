# --- Server-side only (used by the Vercel functions in /api, never sent to the browser) ---

# Neon PostgreSQL connection string.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# The Movie DB API key (Bearer token).
TMDB_API_KEY=your_tmdb_bearer_token

# Admin login used by POST /api/auth/login. Change these from the defaults.
ADMIN_LOGIN=change-me
ADMIN_PASSWORD=change-me-too

# Long random string used to sign session cookies (e.g. `openssl rand -base64 32`).
# Rotating this invalidates all existing sessions.
AUTH_SECRET=replace-with-a-long-random-string

# --- Client-side (optional) ---

# Override the API base path in dev if you're not proxying /api locally.
# VITE_API_BASE_URL=/api
