# --- Server-side only (used by the Vercel functions in /api, never sent to the browser) ---

# Neon PostgreSQL connection string.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# The Movie DB API key (Bearer token).
TMDB_API_KEY=your_tmdb_bearer_token

# Google OAuth 2.0 "Web application" client — create one in Google Cloud Console
# (APIs & Services > Credentials). Any Google account can sign in; there is no
# email allowlist (see the project's multi-user architecture doc).
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Must exactly match one of the "Authorized redirect URIs" configured on the
# Google OAuth client, e.g.:
#   http://localhost:5173/api/auth/google-callback        (local dev)
#   https://your-app.vercel.app/api/auth/google-callback   (production)
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google-callback

# Long random string used to sign session cookies and the OAuth `state`
# parameter (e.g. `openssl rand -base64 32`).
# Rotating this invalidates all existing sessions and any invite links that
# are mid-flight through the Google login redirect (already-accepted invites
# are unaffected — the token is only carried through `state` during login).
AUTH_SECRET=replace-with-a-long-random-string

# --- Client-side (optional) ---

# Override the API base path in dev if you're not proxying /api locally.
# VITE_API_BASE_URL=/api
